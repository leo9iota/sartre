{
    "name": "portfolio",
    "private": true,
    "packageManager": "bun@1.3.5",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
        "format:blog": "prettier --write \"apps/blog/**/*.{ts,tsx,js,mjs,json,md,astro}\"",
        "format:api": "prettier --write \"apps/api/**/*.{ts,js,mjs,json,md}\"",
        "lint": "turbo run lint",
        "lint:blog": "turbo run lint --filter=@portfolio/blog",
        "lint:api": "turbo run lint --filter=@portfolio/api"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.0.0",
        "prettier": "^3.8.0",
        "turbo": "^2.8.3",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.6"
    }
}